# Target compiled binaries generated by Go
/gateway/gateway
/services/auth/auth
/services/project/project
/services/task/task
/services/file/file
/services/notification/notification
/services/reporting/reporting

# Alternative generic rule for any built binaries in subdirectories
# (Useful if you compile using custom naming or script outputs)
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts and performance profiles
*.test
*.out
*.prof
cpu.pprof
mem.pprof

# Database persistence overrides
*.db
*.db-journal
*.sqlite

# IDEs and local environment configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store

# Local vendor folder (only if you run go mod vendor, otherwise handled by go.mod)
vendor/